# What `gcloud builds submit` leaves out of the upload. Cloud Build only needs backend/ and
# cloudbuild.yaml; Terraform state, settings and the app stay on your machine.
.gcloudignore
.git
.github/
# The GitHub deploy job's short-lived sign-in file must never be uploaded.
gha-creds-*.json
#!include:.gitignore
android/
prototype/
infra/
docs/
