<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window before Compose draws; every screen is styled in ui/Theme.kt (always charcoal). -->
    <style name="Theme.FoundWith" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
    <!-- For the screenless activity behind notification buttons. -->
    <style name="Theme.FoundWith.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
